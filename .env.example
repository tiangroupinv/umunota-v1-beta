NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase key for verified provider webhooks and notification delivery. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push / phone-browser notifications.
# Run `npm run generate:vapid` once, then store the generated public/private pair in production env.
# VAPID_SUBJECT must be a real contact URI such as mailto:your-company-email@example.com.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Didit production KYC. Configure a free workflow using ID Verification, passive liveness and face match only.
KYC_PROVIDER=didit
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Paypack handles MTN Mobile Money and Airtel Money through one API.
PAYMENT_PROVIDER=paypack
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_WEBHOOK_MODE=production
