NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# Nodemailer SMTP — server only except the public app URL above.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="UMUNOTA <no-reply@example.com>"
EMAIL_REPLY_TO=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Identity verification now uses UMUNOTA manual review.
# No paid external KYC provider credentials are required.
KYC_PROVIDER=manual

# Paypack (only keep these when live payments are enabled)
PAYMENT_PROVIDER=paypack
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_WEBHOOK_MODE=production
